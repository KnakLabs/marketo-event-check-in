# Marketo REST API credentials — from a custom service (Admin > LaunchPoint)
MARKETO_MUNCHKIN_ID=123-ABC-456
MARKETO_CLIENT_ID=
MARKETO_CLIENT_SECRET=

# The Marketo program to sync this event with (Program Id, not name).
# Can also be passed per-request as { programId } to POST /api/pull.
MARKETO_PROGRAM_ID=

# Program Member status values to write back after the event.
# Must match the status values defined on this program's channel.
MARKETO_ATTENDED_STATUS=Attended
MARKETO_NO_SHOW_STATUS=No Show

# Folder the program picker starts browsing from — staff click through
# subfolders from here down to the program they want, so this just needs
# to be somewhere above all your event programs in Marketo's Design
# Studio folder tree. 123 below is just a placeholder — replace it with
# your own root folder's id.
MARKETO_ROOT_FOLDER_ID=123

# Optional: require this password to use the app. Enough to keep casual
# passersby off a shared laptop or a link at an event. Sessions live in
# server memory (lost on restart) and last 12 hours. 3 wrong guesses from
# one device trigger a 15-minute lockout for that device only — see
# server/src/auth.js for why it's per-device rather than per-IP. Leave
# unset to disable the login screen entirely.
APP_PASSWORD=

PORT=4000
